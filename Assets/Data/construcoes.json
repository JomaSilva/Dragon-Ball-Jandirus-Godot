  { "id": "Nuke", "nome": "Nuke", "desc": "Nukes are very destructive, very big blasts. They absolutely eradicate terrain. Creating one also creates toxic waste.", "custo": 2000000, "tech": 90, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/Lab.tres", "estado": "Tool2", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Bomb/Nuke" },
  { "id": "G_Blaster", "nome": "Gaster Blaster", "desc": "DUN DAH DUN DUN DUH DUN DA... *guitar riff* Basically a better blaster. This is only in the game because Sans got into Smash.", "custo": 3400, "tech": 99, "racas": [], "arte": "res://Assets/Sprites/Weapons/gblaster.tres", "estado": "Handgun", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Guns/G_Blaster" },
  { "id": "Super_Computer", "nome": "Super Computer", "desc": "A super computer to deal with ALL of your robot armies!", "custo": 5000000, "tech": 100, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/Computer.tres", "estado": "Computer", "densa": 1, "px": -22, "py": 0, "tipo": "/obj/Super_Computer" },
  { "id": "Emitter", "nome": "Emitter", "desc": "Emits massive amounts of Blutzwaves, the phenomena, which at regular levels will drive a Saiyan into their Oozaru! This emits much, much more than that.", "custo": 5000000, "tech": 100, "racas": [], "arte": "res://Assets/Sprites/Misc/Moon2.tres", "estado": "On", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Emitter" },
  { "id": "Clone_Machine", "nome": "Clone Machine", "desc": "Have you ever gotten old by a lot? It sucks. Well, if you use a DNA cloning device, store the device, and then use it here, you can get a younger self! Caution: Younger Self may be self-aware. Younger Self also will not have most of it's power at time of collection.", "custo": 10000000, "tech": 100, "racas": [], "arte": "res://Assets/Sprites/Turfs/Turfs 1.tres", "estado": "Healing Tank", "densa": 1, "px": 0, "py": 0, "tipo": "/obj/items/Clone_Machine" },
