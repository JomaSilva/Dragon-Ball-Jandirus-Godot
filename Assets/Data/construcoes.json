  { "id": "Recreator", "nome": "Recreator", "desc": "Recreators use resources to recreate sections of tiles. Activate it via clicking it, selecting two points. It'll save just the turfs and buildable objects in those two points. You can download, and upload, this savefile. It'll cost 10 zenni per turf, 100 zenni per build object. Maximum 30 by 30 size.", "custo": 75000, "tech": 30, "racas": [], "arte": "res://Assets/Sprites/Misc/Ki_Blaster.tres", "estado": "Blaster Big", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Recreator" },
  { "id": "Power_Drill", "nome": "Drill", "desc": "Power Drills let you create large amounts of cash without needing to dig yourself.", "custo": 100000, "tech": 30, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/Drill Giant.tres", "estado": "", "densa": 1, "px": -22, "py": 0, "tipo": "/obj/Power_Drill" },
  { "id": "Rebreather", "nome": "Rebreather", "desc": "Rebreathers let you breathe in space.", "custo": 100000, "tech": 30, "racas": [], "arte": "res://Assets/Sprites/Clothes/Clothes, Ninja Mask.tres", "estado": "", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Rebreather" },
  { "id": "Rocket_Ship", "nome": "Rocket Ship", "desc": "Rocket Ships are basically just one-use pods. They're more expensive to make, but pretty easy to build.", "custo": 200000, "tech": 30, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/rocketship.tres", "estado": "stable", "densa": 1, "px": 0, "py": 0, "tipo": "/obj/Rocketship" },
  { "id": "Forcefield", "nome": "Force Field", "desc": "Forcefields will absorb incoming Ki attacks at the price of it's own armor.", "custo": 150000, "tech": 33, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/Lab.tres", "estado": "Computer 1", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Forcefield" },
  { "id": "Detonator", "nome": "Detonator", "desc": "Detonators can remotely trigger any bombs if given the right code.", "custo": 150000, "tech": 33, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/Cell Phone.tres", "estado": "", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Detonator" },
  { "id": "Regenerator", "nome": "Regenerator", "desc": "Regenerators let you slowly regenerate HP, Ki, and a very small amount of Stamina.", "custo": 75000, "tech": 35, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/regenerator.tres", "estado": "base", "densa": 0, "px": -13, "py": 0, "tipo": "/obj/items/Regenerator" },
  { "id": "Personal_Spacepod", "nome": "Personal Spacepod", "desc": "A personal spacepod for interplanetary travel. Use the Launch verb to fly to your selected destination planet.", "custo": 150000, "tech": 35, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/Spacepod.tres", "estado": "", "densa": 1, "px": 0, "py": 0, "tipo": "/obj/Spacepod" },
