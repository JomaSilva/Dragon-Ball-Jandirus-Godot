  { "id": "Dragon_Radar", "nome": "Dragon Radar", "desc": "Dragon Radars let you locate any item, provided you set the radar to that item in the first place.", "custo": 150000, "tech": 40, "racas": [], "arte": "res://Assets/Sprites/Misc/Misc2.tres", "estado": "Radar", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Radar" },
  { "id": "Simulator", "nome": "Simulator", "desc": "Simulators create mobs for you to defeat.", "custo": 50000, "tech": 45, "racas": [], "arte": "res://Assets/Sprites/Turfs/Space.tres", "estado": "terminal", "densa": 1, "px": 0, "py": 0, "tipo": "/obj/items/Simulator" },
  { "id": "Pkball", "nome": "Pee-Kay Ball", "desc": "A ball whose ability is to capture the DNA of fallen foes and recreate them into a customizable and trainable servant.", "custo": 100000, "tech": 45, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Items/Companion.tres", "estado": "Pball", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/companion_obj/Pkball" },
  { "id": "Pet_Food", "nome": "Pet Food", "desc": "Give it to an out companion or a companion inside a capturer to increase their intelligence.", "custo": 100000, "tech": 45, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Items/Companion.tres", "estado": "Pball", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Pet_Food" },
  { "id": "Stungun", "nome": "Stun Gun", "desc": "Stunguns can stun people, instantly KOing them. Naturally, this doesn't work on people with high health above 100 BP, and are not relaxed. Each shot is pretty expensive too. Best used on already weakened or downed opponents.", "custo": 150000, "tech": 45, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Items/Item, Blaster.tres", "estado": "Blaster Big", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Stungun" },
  { "id": "Player_Fortress", "nome": "Fortress", "desc": "A fortified personal stronghold. Sturdier than a Base Camp and provides faster HP and Ki recovery for the owner.", "custo": 300000, "tech": 45, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/Lab.tres", "estado": "Computer 1", "densa": 1, "px": 0, "py": 0, "tipo": "/obj/PlayerFortress" },
  { "id": "Omniwatch", "nome": "Omniwatch", "desc": "A omni watch does really only one thing- teleport. You can teleport between other watches, or telepads. Works sorta like a Shunkan Ido teleport- it takes longer depending on the distance multiplied by Z-level. You can also wire it to speak to other watches on the same channel, and to give you clothes on clicking.", "custo": 500, "tech": 50, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/Transporter Watch.tres", "estado": "", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Omniwatch" },
  { "id": "Toxic_Waste", "nome": "Toxic Waste", "desc": "Toxic Waste is, well, toxic waste. It doesn't really have a use... You won't fling it near anyone, right!? That's not how it works!!", "custo": 50000, "tech": 50, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/toxicwastebarrel.tres", "estado": "", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Toxic_Waste" },
  { "id": "Android_Creation_Mainframe", "nome": "Android Creation Mainframe", "desc": "Mainframe de criacao de androides. Aparafuse (Bolt) e INSTALE um laboratorio: Android Lab (transforme-se em androide por Absorcao ou Energia Infinita) ou Bio-Android Lab (extraia DNA de jogadores nocauteados e geste um Bio-Androide). A instalacao exige um Humano com muita inteligencia.", "custo": 500000, "tech": 50, "racas": ["Human"], "arte": "res://Assets/Sprites/Misc/Objects/Technology/64x64tech.tres", "estado": "android_pod", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Android_Creation_Mainframe" },
  { "id": "Gravity", "nome": "Gravity", "desc": "Gravitys shunt out massive amounts of force around it. The force may be harmful to you, but it makes for some excellent training grounds.", "custo": 500000, "tech": 50, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/Scan Machine.tres", "estado": "", "densa": 1, "px": 0, "py": 0, "tipo": "/obj/items/Gravity" },
  { "id": "Doll_Core", "nome": "Doll Core", "desc": "The Doll Core is a very unique capsule with a human-type specimen capable of great growth, but is quite weak. It's intelligence is quite high.", "custo": 120000, "tech": 55, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Items/Companion.tres", "estado": "Pball", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/companion_obj/Doll_Core" },
  { "id": "Nav_System", "nome": "Nav System", "desc": "Nav systems automatically collect and categorize all planets capable of hosting sentient life, along with a autopilot and Space GPS.", "custo": 550000, "tech": 55, "racas": [], "arte": "res://Assets/Sprites/Misc/Misc2.tres", "estado": "Radar", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Nav_System" },
  { "id": "Capital_Ship", "nome": "Capital Ship", "desc": "A massive personal starship: walk inside, take the bridge, and launch to space. The most advanced craft you can build.", "custo": 2000000, "tech": 55, "racas": [], "arte": "res://Assets/Sprites/Misc/Ship.tres", "estado": "", "densa": 1, "px": -48, "py": 0, "tipo": "/obj/PlayerShip" },
  { "id": "Ship_Control", "nome": "Console da Ponte", "desc": "O computador principal da Capital Ship. Daqui se pilota, se lanca e se olha onde a nave esta na galaxia. Nao se fabrica: ele nasce com a nave.", "custo": -1, "tech": -1, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/Computer.tres", "estado": "Computer", "densa": 1, "px": 0, "py": 0, "tipo": "/obj/ShipControl" },
  { "id": "Ship_Pad", "nome": "Plataforma de Saida", "desc": "A plataforma no centro do interior da Capital Ship. Sair por ela te poe onde a nave estiver AGORA -- e nao onde voce embarcou.", "custo": -1, "tech": -1, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/Bigteleporter2013.tres", "estado": "", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/ShipPad" },
  { "id": "Teleport_Nullifier", "nome": "Teleport Nullifier", "desc": "A localized teleport nullifier. Will prevent anyone on the same Z-Level from teleporting for about a minute or so. (This includes yourself!) Can be manually turned off, and they don't require being bolted to work.", "custo": 500, "tech": 60, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/nullifier.tres", "estado": "off", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Teleport_Nullifier" },
  { "id": "Saibaman_Capsule", "nome": "Saibaman Capsule", "desc": "Requires also a seed food item. The Saibaman Capsule creates a genetically grown super warrior stronger than many men. It's loyal- but it's also vicious.", "custo": 90000, "tech": 60, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Items/Companion.tres", "estado": "Pball", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/companion_obj/Saibaman_Capsule" },
  { "id": "DNA_Container", "nome": "DNA Container", "desc": "A DNA container is used to input DNA into a cloning machine so that the person's body may be used.", "custo": 100000, "tech": 60, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Items/Item, DNA Extractor.tres", "estado": "", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/dna_container" },
  { "id": "Intercepter_Core", "nome": "Intercepter Core", "desc": "The Intercepter Core is a unique capsule that creates a small intelligent drone capable of shooting down Ki blasts.", "custo": 120000, "tech": 60, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Items/Companion.tres", "estado": "Pball", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/companion_obj/Intercepter_Core" },
  { "id": "Telepad", "nome": "Telepad", "desc": "Telepads are slim floorbound devices that serve as bases for teleportation. They're what you need to be able to teleport effectively.", "custo": 500, "tech": 70, "racas": [], "arte": "res://Assets/Sprites/Misc/Objects/Technology/Transporter Pad.tres", "estado": "", "densa": 0, "px": 0, "py": 0, "tipo": "/obj/items/Telepad" },
