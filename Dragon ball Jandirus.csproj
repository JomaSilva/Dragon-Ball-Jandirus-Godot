<Project Sdk="Godot.NET.Sdk/4.7.1">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jandirus</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      AS PASTAS QUE O BUILD NAO VARRE (2026-10-27, o pedido 122: "antigamente eram apenas alguns segundos, agr pode levar
      ate 2 mins"). O SDK procura **/*.cs, e mais onze padroes (imagens, xaml, resw, resx...), a partir da raiz, e o
      MSBuild 18 percorre a arvore inteira pra CADA padrao, mesmo os de condicao falsa. A exclusao generica de pasta oculta
      (**/.*/**) nao poda nada: so a pasta excluida PELO NOME e pulada inteira. E a Trailer/bruto/appdata guarda uma pasta
      de dados do Godot por bancada (165 mil subpastas de shader_cache em 2026-10-27, e cresce a cada agente novo): so
      AVALIAR o projeto levava ~4 min com a maquina ocupada, e 0,8 s com estas exclusoes. Nenhuma delas tem codigo do jogo
      (o codigo e Client/, Server/ e Net/; o Core entra por ProjectReference). Bancada: `ag/podabuild/avaliacao.py`.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Trailer/**;.claude/**;.godot/**;.git/**;Assets/**;logs/**;bat/**;.idea/**;.tools/**;Core/**;Tools/**;ServidorLinux/**</DefaultItemExcludes>

    <!--
      SEM A ANALISE DE NULOS no build do jogo (o mesmo pedido): ela so produz os avisos CS86xx, e custava um terco da
      compilacao: o GameServer e UMA classe parcial de ~330 mil linhas, e o compilador so paraleliza por classe. Medido
      com o codigo parado: 68,4 s -> 45,6 s, e a DLL sai IDENTICA byte a byte (o `Nullable` continua ligado: as anotacoes
      e os atributos sao os mesmos). O rascunho dos agentes (`_rascunho_6199e7/rascunho.py`) compila com ela, entao os
      avisos de nulo continuam aparecendo pra quem escreve o codigo.
    -->
    <Features>$(Features);run-nullable-analysis=never</Features>
  </PropertyGroup>

  <ItemGroup>
    <!-- as regras do jogo (sem Godot dentro): mesma DLL usada pelo cliente e pelo servidor -->
    <ProjectReference Include="Core\Jandirus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- rede: UDP confiavel com canais, escolha do dono do projeto -->
    <PackageReference Include="LiteNetLib" Version="1.3.1" />

    <!--
      VOZ: Opus em C# PURO (zero binario nativo; e so lib/net8.0/Concentus.dll), o que importa num
      projeto que exporta pro Windows e depende do Godot pra empacotar.

      MEDIDO, quadro de 20 ms a 16 kHz: codificar 102 us (0,51% de um quadro), decodificar 38,2 us,
      39,9 bytes por quadro = 1,95 KB/s por fluxo. Contra 31,2 KB/s do PCM cru e 7,8 KB/s do ADPCM:
      16x e 4x mais barato, e a economia vale no LEQUE (falantes x ouvintes), que e onde a banda
      multiplica. O SERVIDOR nao carrega esta dependencia; ele repassa o payload opaco.
      Ver Core/Social/VozLocal.cs.
    -->
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      O Godot.NET.Sdk varre **/*.cs a partir da raiz do projeto. Sem estas exclusoes ele
      engole os fontes do Core (compilando tudo DUAS vezes: CS0436) e os obj/ dos projetos
      vizinhos (AssemblyInfo duplicado: CS0579). Core entra por ProjectReference, nao por glob.

      ATENCAO: o menu "Criar solucao C#" do editor do Godot SOBRESCREVE este arquivo com o
      modelo dele (sem ProjectReference, sem PackageReference e sem estas exclusoes). Se o build
      voltar a acusar "LiteNetLib nao encontrado" e centenas de "Duplicar atributo", foi isso -
      confira o `git diff` deste csproj antes de procurar em qualquer outro lugar.
    -->
    <Compile Remove="Core\**" />
    <None Remove="Core\**" />
    <Compile Remove="Tools\**" />
    <None Remove="Tools\**" />
    <!-- o lancador `server.dll` dos paineis .NET (projeto proprio, com obj/ proprio) e o pacote do servidor Linux -->
    <Compile Remove="ServidorLinux\**" />
    <None Remove="ServidorLinux\**" />
  </ItemGroup>

</Project>
